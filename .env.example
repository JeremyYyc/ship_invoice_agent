# Application
APP_NAME=ship_invoice_agent
APP_ENV=development
LOG_LEVEL=INFO
JSON_OUTPUT_INDENT=2

# LLM: openai_compatible or langchain_provider
LLM_PROTOCOL=openai_compatible
LLM_PROVIDER=qwen
LLM_MODEL_NAME=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
# prompt is the portable default; native requires provider structured-output support.
LLM_STRUCTURED_OUTPUT_MODE=prompt

# OCR API. Replace only this URL in the enterprise environment.
OCR_API_URL=http://127.0.0.1:8001/process
OCR_HOST_PORT=8001
OCR_TASK=orderChange
OCR_CALLBACK=
OCR_TASK_TYPE=
OCR_CONNECT_TIMEOUT_SECONDS=10
OCR_READ_TIMEOUT_SECONDS=300
OCR_MAX_RETRIES=2
OCR_MAX_RESPONSE_CHARS=200000

# Local file serving used by local OCR development.
LOCAL_FILE_SERVER_HOST=127.0.0.1
LOCAL_FILE_SERVER_PORT=8081
LOCAL_FILE_SERVER_ROOT=.runtime/files
LOCAL_FILE_BASE_URL=http://127.0.0.1:8081

# JSON-backed reference data
EXISTING_BILLS_PATH=data/existing_bills.json
CHARGE_ALIASES_PATH=data/charge_aliases.json
PARTY_ALIASES_PATH=data/party_aliases.json
ACCOUNTING_ENTITIES_PATH=data/accounting_entities.json
CURRENCIES_PATH=data/currencies.json

# Processing
MAX_INPUT_FILE_SIZE_MB=30
MAX_EMAIL_ATTACHMENT_COUNT=30
MAX_EMAIL_RECURSION_DEPTH=3
MAX_DOCUMENT_PAGES=100
DEFAULT_ACCOUNTING_ENTITY=
APPLY_BILL_CHANGES=false
MIN_AUTO_ACCEPT_CONFIDENCE=0.85

# Local OCR engine
LOCAL_OCR_LANGUAGE=eng
LOCAL_OCR_USE_GPU=false

